# Copy to .env and fill in real values. Never commit .env.

# App identity
APP_NAME=AI Company Research Assistant API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# API surface / middleware
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["*"]

# Search — https://serper.dev (get a key at https://serper.dev/api-key)
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev

# AI — https://openrouter.ai (get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL=

# Logging
LOG_LEVEL=INFO

# PDF
PDF_OUTPUT_PATH=./generated_reports

# Crawler / outbound HTTP
MAX_CRAWL_PAGES=10
REQUEST_TIMEOUT=30
USER_AGENT=CompanyResearchAssistant/1.0

# Resilience
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=0.75
AI_REQUEST_TIMEOUT=60
MAX_CONTEXT_WORDS=12000
