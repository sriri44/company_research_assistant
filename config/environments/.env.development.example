# Reference template for local development. The actual files each app
# loads are frontend/.env.example and backend/.env.example — this documents
# how the two apps' env vars relate to each other for local dev.

# Backend (backend/.env)
APP_ENV=development
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Frontend (frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
