# Reference template for production (Vercel + Render). Real secrets are
# set in each platform's dashboard — never committed anywhere.

# Backend (Render environment variables)
APP_ENV=production
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["https://<your-vercel-domain>.vercel.app"]
SERPER_API_KEY=
OPENROUTER_API_KEY=
DISCORD_WEBHOOK_URL=

# Frontend (Vercel environment variables)
VITE_API_BASE_URL=https://<your-render-service>.onrender.com
